generator client {
  provider = "prisma-client"
  output   = "../src/shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FitnessLevel {
  Beginner
  Intermediate
  Advanced
}

enum ChallengeDifficulty {
  Easy
  Medium
  Hard
}

enum FitnessCategory {
  // === Базовые (ваши исходные) ===
  Strength
  Cardio
  Flexibility
  Endurance

  // === Физическая подготовка (детализация) ===
  Mobility // Мобильность (отличается от гибкости, работа с суставами)
  Balance // Баланс и стабильность
  Speed // Скорость
  Agility // Ловкость и координация
  Power // Взрывная сила
  WeightLoss // Похудение / жиросжигание
  MuscleGain // Набор мышечной массы

  // === Здоровье и образ жизни (очень популярны в челленджах) ===
  Nutrition // Питание (например, "без сахара", "подсчет КБЖУ")
  Hydration // Водный баланс
  Sleep // Сон и режим
  Recovery // Восстановление (массаж, растяжка, дни отдыха)
  MentalHealth // Ментальное здоровье
  Mindfulness // Осознанность и медитация
  DailySteps // Ежедневная активность (шаги, NEAT)
  Posture // Осанка

  // === Конкретные спортивные дисциплины ===
  Yoga
  Calisthenics // Воркаут / упражнения с собственным весом
  Running // Бег
  Cycling // Велоспорт
  Swimming // Плавание
  Dance // Танцы
  MartialArts // Единоборства
}

enum ProfileChallengeStatus {
  Active
  Completed
  Failed
}

model Profile {
  id                  String            @id @db.Uuid
  username            String            @unique
  avatarUrl           String?           @map("avatar_url")
  avatarPath          String?           @map("avatar_path")
  fitnessLevel        FitnessLevel      @default(Beginner) @map("fitness_level")
  preferences         FitnessCategory[] @default([])
  bio                 String?
  streakCount         Int               @default(0) @map("streak_count")
  totalCompletedTasks Int               @default(0) @map("total_completed_tasks")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  challenges        Challenge[]
  profileChallenges ProfileChallenge[]
  challengeLikes    ChallengeLike[]
  challengeComments ChallengeComment[]
  achievements      ProfileAchievement[]

  @@map("profiles")
}

model Challenge {
  id                String              @id @default(uuid()) @db.Uuid
  creatorId         String              @map("creator_id") @db.Uuid
  creator           Profile             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title             String
  description       String
  coverImageUrl     String?             @map("cover_image_url")
  category          FitnessCategory
  difficulty        ChallengeDifficulty
  durationDays      Int                 @map("duration_days")
  livesCount        Int                 @map("lives_count")
  isPublished       Boolean             @default(false) @map("is_published")
  likesCount        Int                 @default(0) @map("likes_count")
  participantsCount Int                 @default(0) @map("participants_count")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  dailyTasks        DailyTask[]
  profileChallenges ProfileChallenge[]
  likes             ChallengeLike[]
  comments          ChallengeComment[]

  @@map("challenges")
}

model DailyTask {
  id           String          @id @default(uuid()) @db.Uuid
  challengeId  String          @map("challenge_id") @db.Uuid
  challenge    Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  dayNumber    Int             @map("day_number")
  title        String
  description  String
  exerciseType FitnessCategory @map("exercise_type")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  taskCompletions TaskCompletion[]

  @@unique([challengeId, dayNumber])
  @@map("daily_tasks")
}

model ProfileChallenge {
  profileId   String                 @map("profile_id") @db.Uuid
  challengeId String                 @map("challenge_id") @db.Uuid
  profile     Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  challenge   Challenge              @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  status      ProfileChallengeStatus @default(Active)
  startedAt   DateTime               @default(now()) @map("started_at")
  completedAt DateTime?              @map("completed_at")
  currentDay  Int                    @default(1) @map("current_day")
  missedDays  Int                    @default(0) @map("missed_days")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  taskCompletions TaskCompletion[]

  @@id([profileId, challengeId])
  @@map("profile_challenges")
}

model TaskCompletion {
  profileId        String           @map("profile_id") @db.Uuid
  challengeId      String           @map("challenge_id") @db.Uuid
  dailyTaskId      String           @map("daily_task_id") @db.Uuid
  profileChallenge ProfileChallenge @relation(fields: [profileId, challengeId], references: [profileId, challengeId], onDelete: Cascade)
  dailyTask        DailyTask        @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)
  isCompleted      Boolean          @default(false) @map("is_completed")
  completedAt      DateTime?        @map("completed_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@id([profileId, challengeId, dailyTaskId])
  @@map("task_completions")
}

model ChallengeLike {
  profileId   String    @map("profile_id") @db.Uuid
  challengeId String    @map("challenge_id") @db.Uuid
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([profileId, challengeId])
  @@map("challenge_likes")
}

model ChallengeComment {
  challengeId String    @map("challenge_id") @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@id([challengeId, profileId])
  @@map("challenge_comments")
}

model Achievement {
  id                  String               @id @default(uuid()) @db.Uuid
  title               String
  description         String
  iconUrl             String?              @map("icon_url")
  createdAt           DateTime             @default(now()) @map("created_at")
  profileAchievements ProfileAchievement[]

  @@map("achievements")
}

model ProfileAchievement {
  profileId     String      @map("profile_id") @db.Uuid
  achievementId String      @map("achievement_id") @db.Uuid
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now()) @map("earned_at")

  @@id([profileId, achievementId])
  @@map("profile_achievements")
}
